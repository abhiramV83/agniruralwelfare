PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://127.0.0.1:5173
# Atlas > Connect > Drivers > Node.js. Replace the username, encoded password and database name.
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/agni_rural_welfare?retryWrites=true&w=majority
MONGODB_DATABASE=agni_rural_welfare
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Generate once and retain the same key for the lifetime of encrypted records:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters
SEED_ADMIN_PASSWORD=DemoAdmin2026!
SEED_MEMBER_PASSWORD=DemoMember2026!

# SMTP mail settings (server only; never add these as VITE_* client variables)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-dedicated-mailbox@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=your-dedicated-mailbox@gmail.com
MAIL_FROM_NAME=Agni Rural Welfare Society
MAIL_REPLY_TO=your-reply-address@example.org
